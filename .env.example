# --- MacroPulse data stack ---------------------------------------------------
# MacroPulse ships with a real-context SNAPSHOT so it runs with ZERO config.
# Add keys below to upgrade from demo → live. The data layer is a fallback
# chain, so any subset of keys works; missing pieces degrade gracefully.
#
# PRICES (sectors, themes, stock scores) — first available wins:
#   Polygon.io  (POLYGON_API_KEY)  — exchange-grade, most accurate. Best.
#   FMP         (FMP_API_KEY)      — reliable from servers, free tier.
#   Yahoo       (keyless)          — works locally; often blocked on serverless.
#   Stooq       (keyless)          — last-resort fallback.
#
# SOCIAL / ATTENTION (sentiment, social dominance, conviction, exit timing):
#   LunarCrush  (LUNARCRUSH_API_KEY) — REAL social signal. Without it, social
#                                      metrics are a price/volume-derived proxy.
#   This is the app's differentiator — the biggest accuracy upgrade.

# Exchange-grade prices (recommended). Get a key: https://polygon.io
POLYGON_API_KEY=

# Reliable prices + sector classification, free tier:
#   https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Real social/attention data. Get a key: https://lunarcrush.com/developers/api
LUNARCRUSH_API_KEY=

# Force a provider regardless of which keys are present.
#   snapshot | lunarcrush | stooq | live   (default: auto — lunarcrush if key, else snapshot)
#
# MARKET_DATA_PROVIDER=live turns on live SECTORS + live THEME baskets (real
# prices via the chain above; real social if a LunarCrush key is set). On
# failure it falls back to the bundled snapshot.
#
# NOTE: even in the default snapshot mode, individual ticker STOCK SCORES are
# computed live — only the sector/theme context uses the snapshot.
MARKET_DATA_PROVIDER=

# Benchmark used for relative-strength calcs (default: SPY)
MARKET_BENCHMARK=SPY
