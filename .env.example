# --- MacroPulse data layer ---------------------------------------------------
# MacroPulse ships with a real-context SNAPSHOT so it runs with zero config.
# Provide a LunarCrush API key to switch the data layer to LIVE mode.
#
# Get a key: https://lunarcrush.com/developers/api
LUNARCRUSH_API_KEY=

# Force a provider regardless of which keys are present.
#   snapshot | lunarcrush | stooq | live   (default: auto — lunarcrush if key present, else snapshot)
#
# MARKET_DATA_PROVIDER=live (alias: stooq) is the ZERO-KEY LIVE option: real
# daily prices from Yahoo's keyless chart API (Stooq fallback) power live
# sectors AND live theme baskets. Works from serverless/datacenter hosts like
# Vercel. Social metrics are a transparent price/volume-derived proxy until a
# LunarCrush key is set; on failure it falls back to the bundled snapshot.
#
# NOTE: even in the default snapshot mode, individual ticker STOCK SCORES are
# computed live (Yahoo) — only the sector/theme context uses the snapshot.
MARKET_DATA_PROVIDER=

# Benchmark used for relative-strength calcs (default: SPY)
MARKET_BENCHMARK=SPY

# --- Ticker Map: live classification for ANY ticker --------------------------
# The Ticker Map classifies a stock's sector via: curated map -> live lookup.
# Optional: a free Financial Modeling Prep key makes the live lookup robust.
# Without it, a keyless (unofficial) lookup is used as best-effort fallback.
#   Get a free key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
