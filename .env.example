# --- MacroPulse data layer ---------------------------------------------------
# MacroPulse ships with a real-context SNAPSHOT so it runs with zero config.
# Provide a LunarCrush API key to switch the data layer to LIVE mode.
#
# Get a key: https://lunarcrush.com/developers/api
LUNARCRUSH_API_KEY=

# Force a provider regardless of which keys are present.
#   snapshot | lunarcrush | stooq   (default: auto — lunarcrush if key present, else snapshot)
#
# MARKET_DATA_PROVIDER=stooq is the ZERO-KEY LIVE-PRICE option: it pulls real
# daily prices from Stooq's free CSV feed (no API key). Social metrics are a
# transparent price/volume-derived proxy until a LunarCrush key is set. Requires
# network access; on failure it falls back to the bundled snapshot.
MARKET_DATA_PROVIDER=

# Benchmark used for relative-strength calcs (default: SPY)
MARKET_BENCHMARK=SPY
